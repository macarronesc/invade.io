---
// Sun/moon theme switch shared by the player pages and, through Starlight's
// `ThemeSelect` override, the documentation. Starlight passes no props.
const { es = false } = Astro.props;
---
<button type="button" class="theme-toggle" aria-pressed="true" aria-label={es ? 'Tema oscuro' : 'Dark theme'} hidden>
  <svg class="sun" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" /></svg>
  <svg class="moon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /></svg>
</button>

<style is:global>
  .theme-toggle { position: relative; display: inline-flex; align-items: center; justify-content: space-between; flex: none; width: 4.25rem; height: 2.25rem; padding: 0 0.6rem; border: 1px solid var(--line); border-radius: 999px; background: var(--surface); color: var(--muted); cursor: pointer; transition: border-color 160ms ease; }
  .theme-toggle[hidden] { display: none; }
  .theme-toggle:hover { border-color: var(--primary); }
  .theme-toggle::before { content: ''; position: absolute; top: 0.2rem; left: 0.2rem; width: 1.65rem; height: 1.65rem; border-radius: 50%; background: var(--button); transform: translateX(2rem); transition: transform 160ms ease; }
  .theme-toggle svg { position: relative; z-index: 1; }
  .theme-toggle .moon { color: var(--button-ink); }
  :root[data-theme='light'] .theme-toggle::before { transform: none; }
  :root[data-theme='light'] .theme-toggle .sun { color: var(--button-ink); }
  :root[data-theme='light'] .theme-toggle .moon { color: var(--muted); }
  @media (max-width: 580px) {
    .theme-toggle { width: 3.5rem; height: 2rem; padding-inline: 0.45rem; }
    .theme-toggle::before { top: 0.25rem; width: 1.4rem; height: 1.4rem; transform: translateX(1.5rem); }
  }
</style>

<script>
  const KEY = 'starlight-theme'; // shared with Starlight's own theme provider
  const root = document.documentElement;
  const toggles = document.querySelectorAll<HTMLButtonElement>('.theme-toggle');
  const stored = () => { try { const t = localStorage.getItem(KEY); return t === 'light' || t === 'dark' ? t : null; } catch { return null; } };
  const apply = (theme: string) => {
    root.dataset.theme = theme;
    toggles.forEach((toggle) => toggle.setAttribute('aria-pressed', String(theme === 'dark')));
  };
  const light = matchMedia('(prefers-color-scheme: light)');

  apply(stored() ?? (light.matches ? 'light' : 'dark'));
  toggles.forEach((toggle) => {
    toggle.hidden = false;
    toggle.addEventListener('click', () => {
      const next = root.dataset.theme === 'light' ? 'dark' : 'light';
      try { localStorage.setItem(KEY, next); } catch { /* Browsing without storage still works. */ }
      apply(next);
    });
  });
  light.addEventListener('change', () => { if (!stored()) apply(light.matches ? 'light' : 'dark'); });
</script>
