# Godot 4+ specific ignores
.godot/
/android/
/build/
ios/plugins/backup_file_picker/BackupFilePicker.a
ios/plugins/backup_file_picker/BackupFilePicker.gdip
docs/PLAN_MAESTRO_STATE_IO.md

# Claves de firma: viven fuera del repositorio (ver docs/PLAY_STORE.md)
*.keystore
*.jks
*.b64

# Caché de descargas de tools/build_geo_data.py
tools/.ne_cache/

# Caché de la traducción automática (se regenera con tools/build_locale_csv.py)
tools/.translation_cache.json
tools/__pycache__/

# Temporales locales y credenciales de firma (nunca publicar)
/.tmp
.env
.env.*
!.env.example
*.p12
*.p8
*.pem
*.key
*.pfx
*.mobileprovision
*.provisionprofile
export_credentials.cfg
.venv/
**/__pycache__/

# Static website: generated content is rebuilt from the canonical guides.
/website/node_modules/
/website/.astro/
/website/dist/
/website/src/content/docs/
/website/src/generated/
/website/public/
/website/playwright-report/
/website/test-results/
